{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/session_start.py",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/before_agent.py",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "^(run_shell_command|write_file|replace)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/after_tool.py",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/session_end.py",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
